  - m_Id: 10187555580071936
    m_Localized: Streak of the Month
    m_Metadata:
      m_Items: []
  - m_Id: 11382832529854464
    m_Localized: Can you lend a hand?
    m_Metadata:
      m_Items: []
  - m_Id: 11382832575991808
    m_Localized: "I\u2019m Gonzalo, the solo dev behind Space Express Loops. Your reviews keep this project alive! Got 10 seconds to leave a rating?"
    m_Metadata:
      m_Items: []
  - m_Id: 11382832575991809
    m_Localized: Select to Review
    m_Metadata:
      m_Items: []
  - m_Id: 72242031941570560
    m_Localized: '> PINCH TO SCALE'
    m_Metadata:
      m_Items: []
  - m_Id: 72242031996096512
    m_Localized: '> PINCH AND PULL TO ENTER'
    m_Metadata:
      m_Items: []
  - m_Id: 72242031996096514
    m_Localized: '> GRAB TO MOVE'
    m_Metadata:
      m_Items: []
  - m_Id: 73233989640048640
    m_Localized: '> TWO PINCHES TOGETHER TO EXIT'
    m_Metadata:
      m_Items: []
  - m_Id: 73233989640048641
    m_Localized: '> EACH PINCH SPENDS ENTROPY'
    m_Metadata:
      m_Items: []
  - m_Id: 73233989640048642
    m_Localized: '> SPEND LESS, EARN MORE STARS'
    m_Metadata:
      m_Items: []
  - m_Id: 73233989640048643
