  m_TableData:
  - m_Id: 72150890864889858
    m_Localized: The star is not a planet. It bends the same way.
    m_Metadata:
      m_Items: []
  - m_Id: 72150890864889857
    m_Localized: one bulb
    m_Metadata:
      m_Items: []
  - m_Id: 72150890860695554
    m_Localized: One pinch. You'll be fine.
    m_Metadata:
      m_Items: []
  - m_Id: 72150890860695553
    m_Localized: Welcome. Your Wrap does one thing. Do that one thing.
    m_Metadata:
      m_Items: []
  - m_Id: 72150890860695552
    m_Localized: a pallet of valves
    m_Metadata:
      m_Items: []
  - m_Id: 72150890814558208
    m_Localized: "Bl\xF6dmeyer & Sons (no sons)"
    m_Metadata:
      m_Items: []
  - m_Id: 72150890864889859
    m_Localized: The star is a source too.
    m_Metadata:
      m_Items: []
  - m_Id: 72150890864889856
    m_Localized: The Lighthouse Keepers' Union
    m_Metadata:
      m_Items: []
  - m_Id: 72150890864889884
    m_Localized: Contract closed. The client will hear about the delay.
    m_Metadata:
      m_Items: []
